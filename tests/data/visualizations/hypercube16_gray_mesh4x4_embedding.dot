graph embedding {
  graph [layout=neato, splines=false, overlap=false, outputorder=edgesfirst];
  node [shape=box, style="rounded,filled", fillcolor="#F7F7F7", color="#333333", fontname="Courier"];
  edge [color="#666666", penwidth=2, fontname="Courier"];
  n0 [label="P0\nL0000", pos="0,6!"];
  n1 [label="P1\nL0001", pos="2,6!"];
  n2 [label="P2\nL0011", pos="4,6!"];
  n3 [label="P3\nL0010", pos="6,6!"];
  n4 [label="P4\nL0100", pos="0,4!"];
  n5 [label="P5\nL0101", pos="2,4!"];
  n6 [label="P6\nL0111", pos="4,4!"];
  n7 [label="P7\nL0110", pos="6,4!"];
  n8 [label="P8\nL1100", pos="0,2!"];
  n9 [label="P9\nL1101", pos="2,2!"];
  n10 [label="P10\nL1111", pos="4,2!"];
  n11 [label="P11\nL1110", pos="6,2!"];
  n12 [label="P12\nL1000", pos="0,0!"];
  n13 [label="P13\nL1001", pos="2,0!"];
  n14 [label="P14\nL1011", pos="4,0!"];
  n15 [label="P15\nL1010", pos="6,0!"];
  n0 -- n4 [label="ratio=2\nb2: 0000<->0100\nb3: 0000<->1000"];
  n0 -- n1 [label="ratio=2\nb0: 0000<->0001\nb1: 0000<->0010"];
  n4 -- n8 [label="ratio=2\nb3: 0000<->1000\nb3: 0100<->1100"];
  n4 -- n5 [label="ratio=2\nb0: 0100<->0101\nb1: 0100<->0110"];
  n8 -- n12 [label="ratio=2\nb2: 1000<->1100\nb3: 0000<->1000"];
  n8 -- n9 [label="ratio=2\nb0: 1100<->1101\nb1: 1100<->1110"];
  n12 -- n13 [label="ratio=2\nb0: 1000<->1001\nb1: 1000<->1010"];
  n1 -- n5 [label="ratio=2\nb2: 0001<->0101\nb3: 0001<->1001"];
  n1 -- n2 [label="ratio=2\nb1: 0000<->0010\nb1: 0001<->0011"];
  n5 -- n9 [label="ratio=2\nb3: 0001<->1001\nb3: 0101<->1101"];
  n5 -- n6 [label="ratio=2\nb1: 0100<->0110\nb1: 0101<->0111"];
  n9 -- n13 [label="ratio=2\nb2: 1001<->1101\nb3: 0001<->1001"];
  n9 -- n10 [label="ratio=2\nb1: 1100<->1110\nb1: 1101<->1111"];
  n13 -- n14 [label="ratio=2\nb1: 1000<->1010\nb1: 1001<->1011"];
  n2 -- n6 [label="ratio=2\nb2: 0011<->0111\nb3: 0011<->1011"];
  n2 -- n3 [label="ratio=2\nb0: 0010<->0011\nb1: 0000<->0010"];
  n6 -- n10 [label="ratio=2\nb3: 0011<->1011\nb3: 0111<->1111"];
  n6 -- n7 [label="ratio=2\nb0: 0110<->0111\nb1: 0100<->0110"];
  n10 -- n14 [label="ratio=2\nb2: 1011<->1111\nb3: 0011<->1011"];
  n10 -- n11 [label="ratio=2\nb0: 1110<->1111\nb1: 1100<->1110"];
  n14 -- n15 [label="ratio=2\nb0: 1010<->1011\nb1: 1000<->1010"];
  n3 -- n7 [label="ratio=2\nb2: 0010<->0110\nb3: 0010<->1010"];
  n7 -- n11 [label="ratio=2\nb3: 0010<->1010\nb3: 0110<->1110"];
  n11 -- n15 [label="ratio=2\nb2: 1010<->1110\nb3: 0010<->1010"];
}
